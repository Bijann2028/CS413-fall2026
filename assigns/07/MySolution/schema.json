{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAMBDA3 JSON-RPC transport payloads",
  "description": "Validate using requestPayload or responsePayload; method-specific params are defined in RPC.md.",
  "oneOf": [ {"$ref":"#/$defs/requestPayload"}, {"$ref":"#/$defs/responsePayload"} ],
  "$defs": {
    "id": {"type":["string","number","null"]},
    "request": {
      "type":"object", "required":["jsonrpc","method"],
      "properties": {
        "jsonrpc":{"const":"2.0"}, "method":{"type":"string"},
        "id":{"$ref":"#/$defs/id"}, "params":{"type":"object"}
      }
    },
    "error": {
      "type":"object", "required":["code","message"], "additionalProperties":false,
      "properties":{"code":{"type":"integer"},"message":{"type":"string"},"data":{"type":"object"}}
    },
    "response": {
      "type":"object", "required":["jsonrpc","id"], "additionalProperties":false,
      "properties":{"jsonrpc":{"const":"2.0"},"id":{"$ref":"#/$defs/id"},"result":{},"error":{"$ref":"#/$defs/error"}},
      "oneOf":[{"required":["result"],"not":{"required":["error"]}},{"required":["error"],"not":{"required":["result"]}}]
    },
    "requestPayload":{"oneOf":[{"$ref":"#/$defs/request"},{"type":"array","minItems":1,"items":{"$ref":"#/$defs/request"}}]},
    "responsePayload":{"oneOf":[{"$ref":"#/$defs/response"},{"type":"array","minItems":1,"items":{"$ref":"#/$defs/response"}}]}
  }
}
